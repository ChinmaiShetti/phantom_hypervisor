# Copy to .env (never commit .env). Easiest: run `python scripts/generate_keys.py`
# which creates .env with a fresh Ed25519 key pair and admin secret.

# development | production  (production refuses to start without the secrets below)
APP_ENV=development

# --- License server only (Render: set as secret environment variables) ---
# Base64 of the raw 32-byte Ed25519 private key. NEVER give this to clients.
PHANTOM_PRIVATE_KEY=
# Protects /api/licenses/generate, /revoke, /api/licenses and /api/integrity/simulate
PHANTOM_ADMIN_SECRET=
# Comma-separated license IDs that stay revoked even after a stateless restart
PHANTOM_REVOKED_LICENSES=

# --- Shared ---
PHANTOM_PRODUCT_ID=PHANTOM-DEMO

# --- Client only ---
# Base64 public key (safe to distribute). If empty, the client pins the server's key on first use.
PHANTOM_PUBLIC_KEY=
# Empty = local Docker server (http://phantom-server:8000). Or e.g. https://phantom-xxxx.onrender.com
LICENSE_SERVER_URL=

# Host port for the dashboard (http://localhost:8000). Render sets PORT itself.
HOST_PORT=8000
PORT=8000
